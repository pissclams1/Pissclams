{
  "compilerOptions": {
    "target": "ES2020", "lib": ["dom", "esnext"], "module": "esnext",
    "moduleResolution": "bundler", "strict": true, "noEmit": true,
    "jsx": "preserve", "esModuleInterop": true, "skipLibCheck": true,
    "isolatedModules": true, "resolveJsonModule": true, "incremental": true,
    "plugins": [{ "name": "next" }], "paths": { "@/*": ["./*"] }
  },
  "include": ["**/*.ts", "**/*.tsx", "next-env.d.ts"],
  "exclude": ["node_modules"]
}
